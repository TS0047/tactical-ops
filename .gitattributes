# Normalize line endings to LF on commit, checkout as LF on all platforms
* text=auto eol=lf

# Dart / Flutter
*.dart text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Android / Gradle
*.gradle    text eol=lf
*.kts       text eol=lf
*.properties text eol=lf
*.xml       text eol=lf

# Windows / CMake
*.cmake     text eol=lf
CMakeLists.txt text eol=lf

# Binaries — never touch line endings
*.png  binary
*.jpg  binary
*.ico  binary
*.ttf  binary
*.otf  binary
